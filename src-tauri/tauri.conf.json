{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Radium Math",
  "mainBinaryName": "radium-math",
  "version": "0.1.0",
  "identifier": "com.radiummath.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Radium Math",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "img-src": "'self' blob: data:",
        "connect-src": "ipc: http://ipc.localhost"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "img-src": "'self' blob: data:",
        "connect-src": "ipc: http://ipc.localhost ws://localhost:1420"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
